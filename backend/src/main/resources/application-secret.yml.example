# application-secret.yml 로 복사해 값을 채운다. (application-secret.yml 은 커밋하지 않는다)
spring:
  config:
    activate:
      on-profile: dev
  datasource:
    username: ticketrun
    password: change-me

---
spring:
  config:
    activate:
      on-profile: prod
  datasource:
    url: jdbc:mysql://<host>:3306/ticketrun?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: <username>
    password: <password>
