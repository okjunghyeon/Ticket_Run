# application-secret.yml 로 복사해 값을 채운다. (application-secret.yml 은 커밋하지 않는다)

# ===== 공통 =====
spring:
  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: NEED_TO_INPUT        # 카카오 REST API 키
            client-secret: NEED_TO_INPUT
          google:
            client-id: NEED_TO_INPUT
            client-secret: NEED_TO_INPUT
  data:
    redis:
      password: NEED_TO_INPUT               # infra/.env 의 REDIS_PASSWORD 와 같은 값

auth:
  jwt:
    secret: NEED_TO_INPUT                   # Base64 인코딩된 32바이트 이상 키 (openssl rand -base64 32)

---
# ===== prod =====
spring:
  config:
    activate:
      on-profile: prod
  datasource:
    url: jdbc:mysql://NEED_TO_INPUT:3306/ticketrun?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: NEED_TO_INPUT
    password: NEED_TO_INPUT
  data:
    redis:
      host: NEED_TO_INPUT
      port: 6379
      password: NEED_TO_INPUT
